{
  "name": "llm-ws",
  "version": "1.0.0",
  "description": "Wireframes for LLM agent apps in node and ts",
  "main": "index.ts",
  "repository": "https://github.com/emmaalecrim/llm-ws.git",
  "author": "emmaalecrim <emmaalecrim@gmail.com>",
  "license": "MIT",
  "scripts": {
    "lint": "eslint --fix --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "nodemon ./src/index.ts",
    "redis": "docker run -p 6379:6379 -it redis/redis-stack-server:latest",
    "docker:build": "docker build -t llm-ws .",
    "docker:run": "docker run -p 8080:8080 llm-ws",
    "deploy:build": "gcloud config set project truenation-dev && gcloud builds submit --region=global --config cloudbuild.yaml",
    "deploy:build:prod": "gcloud builds submit --region=global --config prod-cloudbuild.yaml",
    "deploy": "gcloud config set project truenation-dev && gcloud builds submit --region=global --config cloudbuild.yaml && gcloud run deploy glasswall-ws --image europe-west2-docker.pkg.dev/truenation-dev/glasswall-ws/main",
    "deploy:prod": "gcloud builds submit --region=global --config prod-cloudbuild.yaml && gcloud run deploy glasswall-ws --image europe-docker.pkg.dev/truefilter-10000/glasswall-ws/main",
    "auth:refresh": "gcloud auth login && firebase login --reauth",
    "document-api": "ts-node ./src/utils/schemas/generateOAPI.ts"
  },
  "dependencies": {
    "@anatine/zod-openapi": "^2.2.0",
    "@azure/openai": "^1.0.0-beta.5",
    "cors": "^2.8.5",
    "csvtojson": "^2.0.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^11.9.0",
    "jsonwebtoken": "^9.0.2",
    "normalize-text": "^2.4.1",
    "rate-limiter-flexible": "^3.0.0",
    "redis": "^4.6.10",
    "ws": "^8.13.0",
    "zod": "^3.22.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.17",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^5.50.0",
    "eslint": "^8.0.1",
    "eslint-config-standard-with-typescript": "^35.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0",
    "eslint-plugin-promise": "^6.0.0",
    "nodemon": "^2.0.22",
    "openapi3-ts": "^4.1.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
